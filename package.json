{
  "name": "ether-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Ether - Fullstack Academic Portfolio - Node.js Express, SQLite, React",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "test": "npm test --workspace=backend",
    "test:backend": "npm test --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "setup": "npm install && npm run db:seed && npm run build:frontend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:verify": "npm run db:verify --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
