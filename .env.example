# ==========================================
# Configuración del Entorno - Portfolio Fullstack
# ==========================================

# Puerto del servidor backend Express (por defecto: 5000)
PORT=5000

# Entorno de ejecución: 'development' o 'production'
NODE_ENV=development

# URL base del cliente frontend en desarrollo (usado para referencias)
CLIENT_URL=http://localhost:5173

# Clave secreta para firmar tokens JWT (cámbiala en producción)
JWT_SECRET=dev_jwt_secret_key_portfolio_2026

# Servicio de Correo Electrónico (Opcional - si no se configuran, el sistema simula el envío localmente sin errores)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Portfolio Soporte" <soporte@portfolio.local>
